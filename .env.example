# ---------------------------------------------------------------------------
# Google Apps Script Web App URL (this is what sends data to Google Sheets,
# saves the signed agreement + receipt to Google Drive and emails the parent).
#
# 1. Copy this file to ".env" (same folder as package.json)
# 2. Paste your deployed Web App URL below (it ends with /exec)
# 3. Run "npm run build" again so the URL is baked into the website
#
# Leave it empty to run in DEMO mode (nothing is sent anywhere).
# ---------------------------------------------------------------------------
VITE_SHEETS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# Optional extra protection: any random phrase. Use the SAME value for
# CONFIG.SHARED_TOKEN inside google-apps-script/Code.gs. Leave empty to skip.
VITE_FORM_TOKEN=
